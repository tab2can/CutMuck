# Domain for HTTPS (required). Example: cutmuck.example.com
CUTMUCK_DOMAIN=cutmuck.example.com

# Let's Encrypt / ZeroSSL account email
CUTMUCK_EMAIL=admin@example.com

# Optional: pin install path (default /opt/cutmuck)
# CUTMUCK_HOME=/opt/cutmuck

# Optional: git branch to track (default main)
# CUTMUCK_BRANCH=main
